# ── Upstream Kapruka REST API ────────────────────────────────────────────────
KAPRUKA_API_BASE_URL=https://www.kapruka.com
KAPRUKA_API_KEY=your-internal-kapruka-api-key

# ── MCP server bind ──────────────────────────────────────────────────────────
# In production, bind to 127.0.0.1 and let Caddy front it on mcp.kapruka.com.
MCP_HOST=127.0.0.1
MCP_PORT=3200

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── HTTP defaults ────────────────────────────────────────────────────────────
REQUEST_TIMEOUT=30

# ── Free public tier rate limit (per client IP, fixed 60s window) ────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Comma-separated IPs we trust to set X-Real-IP / X-Forwarded-For.
# Leave default for Caddy on the same host. Add Cloudflare ranges if
# you ever put CF in front.
TRUSTED_PROXIES=127.0.0.1,::1

# ── MCP DNS-rebinding protection ─────────────────────────────────────────────
# The MCP SDK rejects requests whose Host/Origin header isn't in these lists.
# Add the public hostname(s) Caddy fronts.
PUBLIC_HOSTS=127.0.0.1:*,localhost:*,[::1]:*,mcp.kapruka.com
PUBLIC_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*,https://mcp.kapruka.com

# ── Trusted partners (X-Partner-Key) — see docs/PARTNER_ACCESS.md ───────────
# For first-party callers that can't be IP-allowlisted (e.g. aloka on Workers).
# Store the SHA-256 of each key, never the key. Repeat a name for rotation.
# Make one: python3 -c "import secrets,hashlib; k=secrets.token_urlsafe(32); print(k); print(hashlib.sha256(k.encode()).hexdigest())"
PARTNER_KEYS=aloka:sha256:<64-hex-sha256-of-the-aloka-key>
# Hidden-tool groups per partner (visual_search, custom_cake). Default: none.
PARTNER_SCOPES=aloka:visual_search,custom_cake
# Optional per-partner overrides (defaults shown).
# PARTNER_LIMITS=aloka:rpm=600,orders_per_hour=300,customer_rpm=60,customer_orders_per_hour=10
# PARTNER_RATE_LIMIT_PER_MINUTE=600
# PARTNER_ORDER_RATE_LIMIT_PER_HOUR=300
# PARTNER_CUSTOMER_RATE_LIMIT_PER_MINUTE=60
# PARTNER_CUSTOMER_ORDER_RATE_LIMIT_PER_HOUR=10
